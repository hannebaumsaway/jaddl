# Copy to .env.local and fill in. Both src/lib/supabase/client.ts and
# src/lib/contentful/client.ts throw at import time when their keys are
# missing, so any page importing them fails hard without a configured env.
#
# On a machine linked to the Vercel project, most of this comes down with:
#   npx vercel link && npx vercel env pull .env.local
#
# NEXT_PUBLIC_ is not decoration: Next inlines any variable with that prefix
# into the JavaScript served to every visitor. Never add it to a secret.

# --- Supabase ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Public, read-only. Row-level security (004_row_level_security.sql) grants
# this key SELECT on every table and nothing else, which is why it is safe to
# ship in the client bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required for ALL writes: score import, playoff seeding, trophies and
# `pnpm sync-players`. Bypasses row-level security entirely, so treat it like
# a password and never prefix it with NEXT_PUBLIC_.
# Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Contentful -------------------------------------------------------------

NEXT_PUBLIC_CONTENTFUL_SPACE_ID=your_contentful_space_id
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=your_contentful_access_token
CONTENTFUL_PREVIEW_ACCESS_TOKEN=your_contentful_preview_token

# Shared secret for POST /api/revalidate, the Contentful webhook target.
# Required — the route fails closed when it is unset.
REVALIDATE_SECRET=your_revalidate_secret

# --- Admin ------------------------------------------------------------------

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Signs the admin session cookie. Without this (and without NEXTAUTH_SECRET as
# a fallback) session creation throws and admin login fails closed, so a
# misconfigured deploy locks admin out rather than opening it up.
# Generate a local one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=your_admin_session_secret

# Legacy fallback signer, used only when ADMIN_SESSION_SECRET is absent.
NEXTAUTH_SECRET=your_nextauth_secret

# --- Sleeper ----------------------------------------------------------------

# The CURRENT season's league id. Sleeper issues a new one each year and chains
# them via previous_league_id, which is how briefs reach past seasons — so this
# needs updating every season.
SLEEPER_LEAGUE_ID=your_sleeper_league_id
